#!/bin/sh

# Writes the Godot C# API differences to GDScript reference into the rules
# directory that Claude Code loads as memory for sessions in `~/GD` and below,
# so that the reference is in context before the first prompt.
#
# The reference has to be inlined rather than referenced. Claude Code loads
# memory files from parent directories but does not follow their `@` imports,
# and it replaces `SessionStart` hook output larger than two kilobytes with a
# preview that has to be read back with a tool.
#
# The reStructuredText source is fetched instead of the rendered page because it
# needs no HTML stripping. A copy less than a day old is treated as fresh so
# that startup stays fast and works offline.
#
# The generated file resolves inside the dotfiles repository because
# `~/GD/.claude` is a symlink, so `.gitignore` excludes it by name.

set -e

url=https://raw.githubusercontent.com/godotengine/godot-docs/refs/heads/stable/tutorials/scripting/c_sharp/c_sharp_differences.rst
ttl=86400

rules_dir="$HOME/GD/.claude/rules"
rules_file="$rules_dir/godot-csharp-differences.md"
cache_dir="$HOME/.claude/cache/godot-docs"
cache="$cache_dir/c_sharp_differences.rst"

# Settings files are not inherited by subdirectories, so this runs from the
# global settings and limits itself to ~/GD and below.
gd_dir=$(CDPATH= cd -- "$HOME" && pwd -P)/GD
current_dir=$(pwd -P)

case "$current_dir" in
  "$gd_dir" | "$gd_dir"/*) ;;
  *) exit 0 ;;
esac

mkdir -p "$cache_dir" "$rules_dir"

if [ -f "$cache" ]; then
  age=$(($(date +%s) - $(stat -f %m "$cache")))
else
  age=$((ttl + 1))
fi

if [ "$age" -gt "$ttl" ]; then
  if curl -fsSL --max-time 10 -o "$cache.new" "$url" 2>/dev/null; then
    mv "$cache.new" "$cache"
  else
    rm -f "$cache.new"
  fi
fi

# A failed fetch with no cached copy leaves any existing rules file alone rather
# than dropping the reference.
if [ ! -s "$cache" ]; then
  exit 0
fi

{
  echo "# Godot C# API differences reference"
  echo
  echo "The remainder of this file is reStructuredText content."
  echo
  cat "$cache"
} > "$rules_file.new"

mv "$rules_file.new" "$rules_file"
